{
  "name": "vezuna-release-tooling",
  "private": true,
  "description": "Pins EAS CLI used only to submit prebuilt native Android/iOS binaries. Vezuna itself is Kotlin Multiplatform + Xcode, not React Native.",
  "license": "MIT",
  "scripts": {
    "submit:android": "eas submit --platform android --profile production --path",
    "submit:ios": "eas submit --platform ios --profile production --path"
  },
  "devDependencies": {
    "eas-cli": "27.4.1"
  },
  "overrides": {
    "eas-cli@27.4.1": {
      "@oclif/plugin-autocomplete": "3.3.0",
      "ajv": "8.20.0",
      "joi": "18.3.2",
      "nanoid": "3.3.20",
      "minimatch@5": "5.1.9",
      "node-forge": "1.4.3",
      "tar": "7.5.22",
      "yaml": "2.9.1"
    }
  }
}
