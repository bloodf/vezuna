---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout locale="en" title="Page not found" description="The requested Vezuna page could not be found." path="/404">
  <main class="simple-main not-found" id="main-content">
    <p class="eyebrow">404</p>
    <h1>This page is not in the record.</h1>
    <p>The address may have changed. Return to the product page or browse the documentation.</p>
    <div class="button-row"><a class="button button--primary" href="/">Return home</a><a class="button button--primary" href="/docs">Read the docs</a></div>
  </main>
</BaseLayout>
