---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout locale="en" title="Page not found" description="The requested Vezuna page could not be found." path="/404">
  <main class="page page--center wrap" id="main-content">
    <p class="status-code" aria-hidden="true">404</p>
    <h1>This page is not in the record.</h1>
    <p class="section-lead">The address may have changed. Go back to the product page or browse the documentation.</p>
    <div class="button-row"><a class="button button--primary" href="/">Go to the product page</a><a class="text-link" href="/docs">Browse the documentation</a></div>
  </main>
</BaseLayout>
