---
import BaseLayout from '../layouts/BaseLayout.astro';
import policy from '../data/privacy-policy.html?raw';
---
<BaseLayout locale="en" title="Vezuna privacy policy" description="How Vezuna handles your records, health permissions, exports, and support requests." path="/privacy" alternates={{ en: '/privacy' }}>
  <main class="page wrap" id="main-content">
    <article class="legal-page" set:html={policy} />
  </main>
</BaseLayout>
