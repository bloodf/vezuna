---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { htmlLang, type Alternates, type Locale } from '../lib/i18n';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
  alternates?: Alternates;
  marketing?: boolean;
}

const { locale, title, description, path, alternates, marketing = false } = Astro.props;
// [data-desktop-open] disclosures (header nav, docs nav) stay expanded on wide screens and
// collapse on narrow ones. A closed <details> hides its content in the UA shadow tree, so CSS
// alone cannot force it open: the inline script at the end of <body> toggles the attribute.
const skipLabel = { en: 'Skip to main content', 'pt-br': 'Pular para o conteúdo', es: 'Saltar al contenido' }[locale];
---
<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <BaseHead lang={locale} title={title} description={description} path={path} alternates={alternates}>
      <slot name="head" slot="head" />
    </BaseHead>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{skipLabel}</a>
    <Header locale={locale} alternates={alternates} marketing={marketing} />
    <slot />
    <Footer locale={locale} />
    <script is:inline>
      (() => {
        const narrow = window.matchMedia('(max-width: 960px)');
        const sync = () => document.querySelectorAll('[data-desktop-open]').forEach((el) => { el.open = !narrow.matches; });
        sync();
        narrow.addEventListener('change', sync);
      })();
    </script>
  </body>
</html>
