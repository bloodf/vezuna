---
import BaseLayout from './BaseLayout.astro';
import { docPath, docsUi, docSlug, type DocEntry } from '../lib/docs';
import type { Alternates, Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  entry: DocEntry;
  entries: DocEntry[];
  path: string;
  alternates: Alternates;
}

const { locale, entry, entries, path, alternates } = Astro.props;
const ui = docsUi[locale];
const currentIndex = entries.findIndex((item) => item.id === entry.id);
const previous = currentIndex > 0 ? entries[currentIndex - 1] : undefined;
const next = currentIndex < entries.length - 1 ? entries[currentIndex + 1] : undefined;
const userDocs = entries.filter((item) => item.data.audience === 'user');
const developerDocs = entries.filter((item) => item.data.audience === 'developer');
const audienceLabel = entry.data.audience === 'developer' ? ui.developer : ui.user;
---
<BaseLayout locale={locale} title={entry.data.title} description={entry.data.description} path={path} alternates={alternates}>
  <link slot="head" rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
  <main class="docs-main" id="main-content">
    <aside class="docs-sidebar">
      <div class="docs-search">
        <span class="docs-search-label">{ui.search}</span>
        <pagefind-searchbox></pagefind-searchbox>
      </div>
      <nav aria-label={ui.sidebar}>
        <div class="docs-nav-groups">
          <div>
            <p class="docs-nav-title">{ui.user}</p>
            <div class="docs-nav">
              {userDocs.map((item) => (
                <a href={docPath(locale, docSlug(item))} aria-current={item.id === entry.id ? 'page' : undefined}>{item.data.title}</a>
              ))}
            </div>
          </div>
          {developerDocs.length > 0 && (
            <div>
              <p class="docs-nav-title">{ui.developer}</p>
              <div class="docs-nav">
                {developerDocs.map((item) => (
                  <a href={docPath(locale, docSlug(item))} aria-current={item.id === entry.id ? 'page' : undefined}>{item.data.title}</a>
                ))}
              </div>
            </div>
          )}
        </div>
      </nav>
    </aside>
    <article class="docs-article">
      <header>
        <p class="docs-breadcrumb">{audienceLabel} / {ui.title}</p>
        <h1>{entry.data.title}</h1>
        <p class="docs-description">{entry.data.description}</p>
      </header>
      <div class="docs-prose" data-pagefind-body>
        <slot />
      </div>
      <nav class="docs-pagination" aria-label={ui.sidebar}>
        <div>
          {previous && <a href={docPath(locale, docSlug(previous))}><span>← {ui.previous}</span>{previous.data.title}</a>}
        </div>
        <div>
          {next && <a href={docPath(locale, docSlug(next))}><span>{ui.next} →</span>{next.data.title}</a>}
        </div>
      </nav>
    </article>
  </main>
  <script is:inline type="module" src="/pagefind/pagefind-component-ui.js"></script>
  <script is:inline define:vars={{ copyLabel: ui.copy, copiedLabel: ui.copied }}>
    document.querySelectorAll('.docs-prose pre').forEach((pre) => {
      const wrapper = document.createElement('div');
      wrapper.className = 'code-wrap';
      pre.parentNode.insertBefore(wrapper, pre);
      wrapper.appendChild(pre);
      const button = document.createElement('button');
      button.className = 'copy-code';
      button.type = 'button';
      button.textContent = copyLabel;
      button.setAttribute('aria-label', copyLabel);
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.textContent || '');
          button.textContent = copiedLabel;
          window.setTimeout(() => { button.textContent = copyLabel; }, 1600);
        } catch {
          button.textContent = copyLabel;
        }
      });
      wrapper.appendChild(button);
    });
  </script>
</BaseLayout>
