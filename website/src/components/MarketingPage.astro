---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductWorkspace from './ProductWorkspace.astro';
import { marketingCopy } from '../data/marketing';
import { localizedPath, marketingAlternates, repositoryUrl, type Locale } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = marketingCopy[locale];
const path = localizedPath(locale);
const descriptions = {
  en: 'Organize household lab reports, medication schedules, weight, heart rate, steps, and health records on your device.',
  'pt-br': 'Organize exames, horários de medicamentos, peso, frequência cardíaca, passos e registros de saúde da família no seu dispositivo.',
  es: 'Organiza exámenes, horarios de medicamentos, peso, frecuencia cardíaca, pasos y registros de salud familiares en tu dispositivo.',
};
---
<BaseLayout locale={locale} title="Vezuna" description={descriptions[locale]} path={path} alternates={marketingAlternates} marketing>
  <main id="main-content">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">{copy.hero.eyebrow}</p>
          <h1 id="hero-title">{copy.hero.title}</h1>
          <p class="hero-intro">{copy.hero.body}</p>
          <div class="button-row">
            <a class="button button--primary" href="#workspace">{copy.hero.primary}</a>
            <a class="text-link" href={localizedPath(locale, 'docs')}>{copy.hero.secondary}</a>
          </div>
          <p class="hero-note">{copy.hero.note}</p>
        </div>
        <div id="workspace">
          <ProductWorkspace copy={copy} />
        </div>
      </div>
      <ul class="fact-strip" aria-label="Product facts">
        {copy.facts.map((fact) => <li>{fact}</li>)}
      </ul>
    </section>

    <section class="journey" id="journey" aria-labelledby="journey-title">
      <div class="journey-copy">
        <p class="eyebrow">{copy.journey.eyebrow}</p>
        <h2 id="journey-title">{copy.journey.title}</h2>
        <ol class="journey-steps">
          {copy.journey.steps.map((step) => (
            <li><h3>{step.title}</h3><p>{step.body}</p></li>
          ))}
        </ol>
      </div>
      <figure class="journey-screen">
        <img src="/assets/android-labs.png" width="1080" height="2340" loading="lazy" alt={copy.gallery.screenshots[1].alt} />
        <figcaption>{copy.gallery.caption}</figcaption>
      </figure>
    </section>

    <section class="app-gallery" id="gallery" aria-labelledby="gallery-title">
      <header class="section-heading">
        <p class="eyebrow">Vezuna</p>
        <h2 id="gallery-title">{copy.gallery.title}</h2>
        <p>{copy.gallery.caption}</p>
      </header>
      <div class="gallery-grid">
        {copy.gallery.screenshots.map((screen) => (
          <figure class="gallery-item">
            <img src={screen.src} width="1080" height="2340" loading="lazy" alt={screen.alt} />
            <figcaption>{screen.label}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="privacy-section" id="privacy" aria-labelledby="privacy-title">
      <header class="section-heading">
        <p class="eyebrow">Privacy</p>
        <h2 id="privacy-title">{copy.privacy.title}</h2>
        <p>{copy.privacy.body}</p>
      </header>
      <div class="privacy-points">
        {copy.privacy.points.map((point) => (
          <article><h3>{point.title}</h3><p>{point.body}</p></article>
        ))}
      </div>
    </section>

    <section class="availability" aria-labelledby="availability-title">
      <div>
        <p class="eyebrow">Availability</p>
        <h2 id="availability-title">{copy.availability.title}</h2>
        <p>{copy.availability.body}</p>
      </div>
      <div class="availability-actions">
        <a class="button button--primary" href={repositoryUrl} rel="external">{copy.availability.github}</a>
        <div class="store-states" aria-label={copy.availability.pending}>
          <span class="store-pending">{copy.availability.appStore}</span>
          <span class="store-pending">{copy.availability.googlePlay}</span>
        </div>
        <p class="availability-pending">{copy.availability.pending}</p>
      </div>
    </section>

    <section class="faq" id="faq" aria-labelledby="faq-title">
      <header class="section-heading"><p class="eyebrow">FAQ</p><h2 id="faq-title">{copy.faq.title}</h2></header>
      <div class="faq-list">
        {copy.faq.items.map((item) => (
          <article class="faq-item"><h3>{item.question}</h3><p>{item.answer}</p></article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
