---
import BaseLayout from '../layouts/BaseLayout.astro';
import Screen from './Screen.astro';
import { marketingCopy } from '../data/marketing';
import { localizedPath, marketingAlternates, repositoryUrl, type Locale } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = marketingCopy[locale];
const guide = localizedPath(locale, 'docs/getting-started');
const privacyDocs = '/docs/privacy-and-data';
---
<BaseLayout locale={locale} title={copy.meta.title} description={copy.meta.description} path={localizedPath(locale)} alternates={marketingAlternates} marketing>
  <main id="main-content">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-grid wrap">
        <div class="hero-copy">
          <h1 id="hero-title">{copy.hero.title}</h1>
          <p class="hero-lead">{copy.hero.body}</p>
          <div class="button-row">
            <a class="button button--primary" href={guide}>{copy.hero.primary}</a>
            <a class="text-link" href="#price">{copy.hero.secondary}</a>
          </div>
          <dl class="fact-sheet">
            {copy.hero.facts.map((fact) => (
              <div><dt>{fact.term}</dt><dd>{fact.value}</dd></div>
            ))}
          </dl>
        </div>
        <Screen screen={copy.hero.screen} crop={0.62} eager />
      </div>
    </section>

    <section class="band" id="how" aria-labelledby="how-title">
      <div class="split wrap">
        <div class="split-main">
          <h2 id="how-title">{copy.how.title}</h2>
          <p class="section-lead">{copy.how.body}</p>
          <ol class="steps">
            {copy.how.steps.map((step) => (
              <li><h3>{step.title}</h3><p>{step.body}</p></li>
            ))}
          </ol>
        </div>
        <Screen screen={copy.how.screen} crop={0.56} />
      </div>
    </section>

    <section class="band band--subtle" id="records" aria-labelledby="records-title">
      <div class="split split--reverse wrap">
        <div class="split-main">
          <h2 id="records-title">{copy.records.title}</h2>
          <p class="section-lead">{copy.records.body}</p>
          <dl class="ledger">
            {copy.records.items.map((item) => (
              <div><dt>{item.term}</dt><dd>{item.body}</dd></div>
            ))}
          </dl>
        </div>
        <Screen screen={copy.records.screen} crop={0.56} />
      </div>
    </section>

    <section class="band band--dark" id="privacy" aria-labelledby="privacy-title">
      <div class="wrap">
        <header class="section-head">
          <h2 id="privacy-title">{copy.privacy.title}</h2>
          <p class="section-lead">{copy.privacy.body}</p>
        </header>
        <div class="table-scroll" role="region" aria-labelledby="privacy-title" tabindex="0">
          <table class="data-map">
            <thead>
              <tr><th scope="col">{copy.privacy.columns.what}</th><th scope="col">{copy.privacy.columns.where}</th><th scope="col">{copy.privacy.columns.leaves}</th></tr>
            </thead>
            <tbody>
              {copy.privacy.rows.map((row) => (
                <tr><th scope="row">{row.what}</th><td data-label={copy.privacy.columns.where}>{row.where}</td><td data-label={copy.privacy.columns.leaves}>{row.leaves}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="privacy-note">{copy.privacy.note}</p>
        <p class="link-row"><a href="/privacy">{copy.privacy.policy}</a><a href={privacyDocs}>{copy.privacy.details}</a></p>
      </div>
    </section>

    <section class="band" id="price" aria-labelledby="price-title">
      <div class="price wrap">
        <p class="price-amount" aria-hidden="true">{copy.price.amount}</p>
        <div class="price-copy">
          <h2 id="price-title"><span class="visually-hidden">{copy.price.amount}. </span>{copy.price.title}</h2>
          <p>{copy.price.body}</p>
          <p class="price-status">{copy.price.status}</p>
          <div class="button-row">
            <a class="button button--primary" href={guide}>{copy.price.primary}</a>
            <a class="text-link" href={repositoryUrl} rel="external">{copy.price.secondary}</a>
          </div>
        </div>
      </div>
    </section>

    <section class="band band--subtle" id="faq" aria-labelledby="faq-title">
      <div class="split split--faq wrap">
        <h2 id="faq-title">{copy.faq.title}</h2>
        <div class="faq-list">
          {copy.faq.items.map((item) => (
            <details class="faq-item">
              <summary><span>{item.question}</span><span class="icon icon-plus" aria-hidden="true"></span></summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
