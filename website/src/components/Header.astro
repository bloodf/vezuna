---
import { marketingCopy } from '../data/marketing';
import { htmlLang, languageNames, localizedPath, type Alternates, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  alternates?: Alternates;
  marketing?: boolean;
}

const { locale, alternates = {}, marketing = false } = Astro.props;
const copy = marketingCopy[locale];
const home = localizedPath(locale);
const docs = localizedPath(locale, 'docs');
const support = localizedPath(locale, 'support');
const pathname = Astro.url.pathname;
const sectionLinks = [
  { href: '#how', label: copy.nav.how },
  { href: '#records', label: copy.nav.records },
  { href: '#privacy', label: copy.nav.privacy },
  { href: '#price', label: copy.nav.price },
  { href: '#faq', label: copy.nav.faq },
];
---
<header class="site-header">
  <div class="header-inner wrap">
    <a class="brand-link" href={home} aria-label={copy.nav.home}>
      <img src="/assets/lockup-color.svg" width="154" height="44" alt="Vezuna" />
    </a>
    <details class="navigation" data-desktop-open open>
      <summary><span>{copy.nav.menu}</span><span class="icon icon-chevron icon-chevron--down" aria-hidden="true"></span></summary>
      <div class="nav-panel">
        <nav class="primary-nav" aria-label={copy.nav.menu}>
          {marketing ? (
            <>
              {sectionLinks.map((link) => <a href={link.href}>{link.label}</a>)}
              <a href={docs}>{copy.nav.docs}</a>
            </>
          ) : (
            <>
              <a href={home}>{copy.nav.product}</a>
              <a href={docs} aria-current={pathname.includes('/docs') ? 'page' : undefined}>{copy.footer.docs}</a>
              <a href={support} aria-current={pathname.endsWith('/support') ? 'page' : undefined}>{copy.footer.support}</a>
            </>
          )}
        </nav>
        {Object.keys(alternates).length > 1 && (
          <nav class="language-nav" aria-label="Language / Idioma">
            {Object.entries(alternates).map(([itemLocale, href]) => (
              <a href={href} hreflang={htmlLang[itemLocale as Locale]} lang={htmlLang[itemLocale as Locale]} aria-current={itemLocale === locale ? 'page' : undefined} aria-label={languageNames[itemLocale as Locale]}>
                {itemLocale === 'pt-br' ? 'PT' : itemLocale.toUpperCase()}
              </a>
            ))}
          </nav>
        )}
      </div>
    </details>
  </div>
</header>
