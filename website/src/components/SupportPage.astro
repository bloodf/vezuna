---
import BaseLayout from '../layouts/BaseLayout.astro';
import { supportCopy } from '../data/marketing';
import { issuesUrl, localizedPath, securityUrl, supportAlternates, type Locale } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = supportCopy[locale];
const supportEmail = 'heitor.ramon@gmail.com';
---
<BaseLayout locale={locale} title={copy.title} description={copy.intro} path={localizedPath(locale, 'support')} alternates={supportAlternates}>
  <main class="page wrap" id="main-content">
    <header class="page-head">
      <h1>{copy.title}</h1>
      <p class="section-lead">{copy.intro}</p>
    </header>
    <p class="notice notice--warning" role="note">{copy.warning}</p>
    <div class="channels">
      <section class="channel" aria-labelledby="email-support">
        <h2 id="email-support">{copy.emailTitle}</h2>
        <p>{copy.emailBody}</p>
        <a class="channel-email" href={`mailto:${supportEmail}`}>{supportEmail}</a>
      </section>
      <section class="channel" aria-labelledby="general-support">
        <h2 id="general-support">{copy.generalTitle}</h2>
        <p>{copy.generalBody}</p>
        <a class="button button--secondary" href={issuesUrl} rel="external">{copy.action}</a>
      </section>
      <section class="channel" aria-labelledby="security-support">
        <h2 id="security-support">{copy.securityTitle}</h2>
        <p>{copy.securityBody}</p>
        <p class="channel-fine">{copy.fallback}</p>
        <a class="button button--secondary" href={securityUrl} rel="external">{copy.securityAction}</a>
      </section>
    </div>
  </main>
</BaseLayout>
