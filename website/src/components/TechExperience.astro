---
import type { MarketingCopy } from '../data/marketing';
import { repositoryUrl } from '../lib/i18n';

interface Props {
  tech: MarketingCopy['tech'];
  availability: MarketingCopy['availability'];
}
const { tech, availability } = Astro.props;
---
<div class="tech-experience" data-tech-experience>
  <header class="tech-heading">
    <p class="eyebrow">{tech.eyebrow}</p>
    <h2>{tech.title}</h2>
    <p>{tech.description}</p>
  </header>
  <div class="health-scene-stage">
    <canvas class="health-scene-canvas" data-health-scene aria-hidden="true"></canvas>
    <div class="scene-grid" aria-hidden="true"></div>
    <div class="scene-label scene-label--draft"><span class="scene-index">01</span>{tech.draft}</div>
    <div class="scene-label scene-label--confirmed"><span class="scene-index">02</span>{tech.confirmed}</div>
    <div class="scene-label scene-label--comparison"><span class="scene-index">03</span>{tech.comparison}</div>
    <div class="scene-label scene-label--local"><span class="scene-pulse" aria-hidden="true"></span>{tech.local}</div>
    <div class="scene-readout" aria-hidden="true">
      <span>Hemoglobin</span>
      <strong>13.2 <small>g/dL</small></strong>
      <span class="scene-synthetic">Synthetic record</span>
    </div>
  </div>
  <p class="scene-note">{tech.staticNote}</p>
</div>

<section class="availability" aria-labelledby="availability-title">
  <div>
    <p class="eyebrow">{availability.eyebrow}</p>
    <h2 id="availability-title">{availability.title}</h2>
    <p>{availability.body}</p>
  </div>
  <div class="availability-actions">
    <a class="button button--aqua" href={repositoryUrl} rel="external">{availability.github}</a>
    <div class="store-states" aria-label={availability.pending}>
      <span class="store-pending">{availability.appStore}</span>
      <span class="store-pending">{availability.googlePlay}</span>
    </div>
    <p class="availability-pending">{availability.pending}</p>
  </div>
</section>

<script>
  void import('../scripts/health-scene').then(({ mountHealthScene }) => {
    document.querySelectorAll('[data-health-scene]').forEach((canvas) => {
      if (canvas instanceof HTMLCanvasElement) mountHealthScene(canvas);
    });
  });

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const finePointer = window.matchMedia('(pointer: fine)');
  document.querySelectorAll('[data-tilt]').forEach((element) => {
    if (!(element instanceof HTMLElement)) return;
    const frame = element.querySelector('.screenshot-frame');
    if (!(frame instanceof HTMLElement)) return;
    element.addEventListener('pointermove', (event) => {
      if (reducedMotion.matches || !finePointer.matches) return;
      const bounds = element.getBoundingClientRect();
      const x = (event.clientX - bounds.left) / bounds.width - 0.5;
      const y = (event.clientY - bounds.top) / bounds.height - 0.5;
      frame.style.setProperty('--tilt-x', `${(-y * 4).toFixed(2)}deg`);
      frame.style.setProperty('--tilt-y', `${(x * 5).toFixed(2)}deg`);
    }, { passive: true });
    element.addEventListener('pointerleave', () => {
      frame.style.setProperty('--tilt-x', '0deg');
      frame.style.setProperty('--tilt-y', '0deg');
    }, { passive: true });
  });
</script>
