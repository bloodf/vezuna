---
import type { MarketingCopy } from '../data/marketing';

interface Props {
  copy: MarketingCopy;
}

const { copy } = Astro.props;
const tabs = copy.workspace.tabs;
const labResults = [
  { value: copy.lab.firstValue, date: copy.lab.firstDate },
  { value: copy.lab.secondValue, date: copy.lab.secondDate },
];
const labValues = labResults.map((result) => Number(result.value.replace(',', '.')));
const labMinimum = Math.min(...labValues);
const labMaximum = Math.max(...labValues);
const labDifference = labMaximum - labMinimum;
const labPadding = labDifference === 0 ? Math.max(Math.abs(labMaximum) * 0.1, 1) : labDifference * 0.5;
const labLow = Math.max(0, labMinimum - labPadding);
const labHigh = labMaximum + labPadding;
const labGrid = [0, 1, 2, 3].map((step) => {
  const ratio = step / 3;
  return {
    y: 50 + ratio * 140,
    value: Number((labHigh - ratio * (labHigh - labLow)).toFixed(2)),
  };
});
const labPoints = labResults.map((result, index) => ({
  ...result,
  x: 110 + index * 440,
  y: 190 - ((Number(result.value.replace(',', '.')) - labLow) / (labHigh - labLow)) * 140,
}));
---

<section class="workspace-section" aria-labelledby="workspace-title" data-workspace>
  <header class="workspace-header">
    <h2 id="workspace-title">{copy.workspace.title}</h2>
    <p class="workspace-intro">{copy.workspace.intro}</p>
    <p class="workspace-synthetic-note">{copy.workspace.syntheticNote}</p>
  </header>

  <div class="workspace-tabs" role="tablist" aria-label={copy.workspace.title}>
    {tabs.map((tab, index) => (
      <button
        class="workspace-tab"
        id={`workspace-tab-${tab.id}`}
        type="button"
        role="tab"
        aria-selected={index === 0 ? 'true' : 'false'}
        aria-controls={`workspace-panel-${tab.id}`}
        tabindex={index === 0 ? 0 : -1}
      >
        {tab.label}
      </button>
    ))}
  </div>

  <div
    class="workspace-panel lab-panel"
    id="workspace-panel-labs"
    role="tabpanel"
    aria-labelledby="workspace-tab-labs"
    tabindex="0"
  >
    <header class="lab-header">
      <h3 class="lab-title">{copy.lab.title}</h3>
      <p class="lab-test">{copy.lab.test}</p>
    </header>
    <figure class="lab-figure" aria-labelledby="lab-chart-summary">
      <svg class="lab-chart" viewBox="0 0 640 250" aria-hidden="true" focusable="false">
        {labGrid.map((line) => (
          <g class="lab-chart-grid-row">
            <line class="lab-chart-grid" x1="72" x2="580" y1={line.y} y2={line.y} stroke="currentColor" opacity="0.2" />
            <text class="lab-chart-grid-value" x="60" y={line.y + 4} text-anchor="end" fill="currentColor">{line.value}</text>
          </g>
        ))}
        <polyline
          class="lab-chart-line"
          points={labPoints.map((point) => `${point.x},${point.y}`).join(' ')}
          fill="none"
          stroke="currentColor"
          stroke-width="3"
        />
        {labPoints.map((point) => (
          <g class="lab-chart-result">
            <circle class="lab-chart-point" cx={point.x} cy={point.y} r="7" fill="currentColor" stroke="white" stroke-width="3" />
            <text class="lab-chart-value" x={point.x} y={point.y - 16} text-anchor="middle" fill="currentColor">
              {point.value} {copy.lab.unit}
            </text>
            <text class="lab-chart-date" x={point.x} y="225" text-anchor="middle" fill="currentColor">{point.date}</text>
          </g>
        ))}
      </svg>
      <figcaption class="lab-chart-summary" id="lab-chart-summary">{copy.lab.chartSummary}</figcaption>
    </figure>

    <table class="lab-results">
      <caption>{copy.lab.chartSummary}</caption>
      <tbody>
        {labResults.map((result) => (
          <tr class="lab-result-row">
            <th class="lab-result-date" scope="row">{result.date}</th>
            <td class="lab-result-value">{result.value} {copy.lab.unit}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="lab-review-status">{copy.lab.reviewStatus}</p>
  </div>

  <div
    class="workspace-panel meds-panel"
    id="workspace-panel-meds"
    role="tabpanel"
    aria-labelledby="workspace-tab-meds"
    tabindex="0"
    hidden
  >
    <h3 class="meds-title">{copy.meds.title}</h3>
    <ol class="meds-schedule">
      {copy.meds.schedule.map((item) => (
        <li class="meds-schedule-row">
          <time class="meds-schedule-time">{item.time}</time>
          <div class="meds-schedule-details">
            <h4 class="meds-schedule-title">{item.name}</h4>
            <p class="meds-schedule-detail">{item.detail}</p>
          </div>
          <span class="meds-schedule-state">{item.state}</span>
        </li>
      ))}
    </ol>
    <p class="meds-note">{copy.meds.note}</p>
  </div>

  <div
    class="workspace-panel device-panel"
    id="workspace-panel-device"
    role="tabpanel"
    aria-labelledby="workspace-tab-device"
    tabindex="0"
    hidden
  >
    <h3 class="device-title">{copy.device.title}</h3>
    <dl class="device-metrics">
      {copy.device.metrics.map((metric) => (
        <div class="device-metric-row">
          <dt class="device-metric-label">{metric.label}</dt>
          <dd class="device-metric-reading">
            <span class="device-metric-value">{metric.value}</span>
            <span class="device-metric-unit">{metric.unit}</span>
            <span class="device-metric-note">{metric.note}</span>
          </dd>
        </div>
      ))}
    </dl>
    <p class="device-permission-note">{copy.device.permissionNote}</p>
  </div>

  <div
    class="workspace-panel household-panel"
    id="workspace-panel-household"
    role="tabpanel"
    aria-labelledby="workspace-tab-household"
    tabindex="0"
    hidden
  >
    <h3 class="household-title">{copy.household.title}</h3>
    <ul class="household-profiles">
      {copy.household.profiles.map((profile) => (
        <li class="household-profile-row">
          <h4 class="household-profile-name">{profile.name}</h4>
          <p class="household-profile-detail">{profile.detail}</p>
        </li>
      ))}
    </ul>
    <div class="household-exports">
      <h4 class="household-exports-title">{copy.household.exportsTitle}</h4>
      <p class="household-exports-body">{copy.household.exportsBody}</p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-workspace]').forEach((workspace) => {
    const tabs = Array.from(workspace.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = tabs.map((tab) => workspace.querySelector<HTMLElement>(`#${tab.getAttribute('aria-controls')}`));

    const selectTab = (selectedIndex: number, moveFocus = false, updateHash = false) => {
      tabs.forEach((tab, index) => {
        const selected = index === selectedIndex;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        const panel = panels[index];
        if (panel) panel.hidden = !selected;
      });
      if (moveFocus) tabs[selectedIndex].focus();
      if (updateHash) history.replaceState(null, '', `#${tabs[selectedIndex].id}`);
    };

    const selectTabForHash = () => {
      const selectedIndex = tabs.findIndex((tab) => `#${tab.id}` === location.hash);
      if (selectedIndex >= 0) selectTab(selectedIndex);
    };
    window.addEventListener('hashchange', selectTabForHash);
    selectTabForHash();

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectTab(index, false, true));
      tab.addEventListener('keydown', (event) => {
        let nextIndex: number | undefined;
        if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
        if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
        if (event.key === 'Home') nextIndex = 0;
        if (event.key === 'End') nextIndex = tabs.length - 1;
        if (nextIndex === undefined) return;
        event.preventDefault();
        selectTab(nextIndex, true, true);
      });
    });
  });
</script>
