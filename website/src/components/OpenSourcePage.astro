---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import { openSourceCopy } from '../data/pages';
import {
  contributingUrl, developmentGuideUrl, issuesUrl, licenseUrl, localizedPath,
  noticesUrl, repositoryUrl, securityUrl, type Alternates, type Locale,
} from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = openSourceCopy[locale];
// The developer guide is written in English only; the locale doc indexes link it the same way.
const developers = '/docs/developers';
const noticesPage = '/notices';
const alternates: Alternates = {
  en: '/open-source',
  'pt-br': '/pt-br/open-source',
  es: '/es/open-source',
};
const linkCards = [
  { href: repositoryUrl, label: copy.links.repository, external: true },
  { href: issuesUrl, label: copy.links.issues, external: true },
  { href: securityUrl, label: copy.links.security, external: true },
  { href: contributingUrl, label: copy.links.contributing, external: true },
  { href: noticesUrl, label: copy.links.notices, external: true },
  { href: licenseUrl, label: copy.links.license, external: true },
];
---
<BaseLayout locale={locale} title={copy.meta.title} description={copy.meta.description} path={localizedPath(locale, 'open-source')} alternates={alternates}>
  <main id="main-content">
    <PageHero eyebrow={copy.hero.eyebrow} title={copy.hero.title} body={copy.hero.body} facts={copy.hero.facts}>
      <div class="button-row hero-actions">
        <a class="button button--primary" href={developers}>{copy.hero.primary}</a>
        <a class="text-link" href={repositoryUrl} rel="external">{copy.hero.secondary}</a>
      </div>
    </PageHero>

    <section class="band band--subtle" aria-labelledby="covered-title">
      <div class="wrap">
        <header class="section-head">
          <h2 id="covered-title">{copy.covered.title}</h2>
          <p class="section-lead">{copy.covered.body}</p>
        </header>
        <div class="table-scroll" role="region" aria-labelledby="covered-title" tabindex="0">
          <table class="spec-table">
            <thead>
              <tr><th scope="col">{copy.covered.columns.term}</th><th scope="col">{copy.covered.columns.body}</th></tr>
            </thead>
            <tbody>
              {copy.covered.rows.map((row) => (
                <tr><th scope="row"><code>{row.term}</code></th><td data-label={copy.covered.columns.body}>{row.body}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="band band--dark" aria-labelledby="excluded-title">
      <div class="wrap">
        <header class="section-head">
          <h2 id="excluded-title">{copy.excluded.title}</h2>
          <p class="section-lead">{copy.excluded.body}</p>
        </header>
        <div class="table-scroll" role="region" aria-labelledby="excluded-title" tabindex="0">
          <table class="data-map">
            <thead>
              <tr><th scope="col">{copy.excluded.columns.term}</th><th scope="col">{copy.excluded.columns.terms}</th></tr>
            </thead>
            <tbody>
              {copy.excluded.rows.map((row) => (
                <tr><th scope="row">{row.term}</th><td data-label={copy.excluded.columns.terms}>{row.terms}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="privacy-note">{copy.excluded.note}</p>
        <p class="link-row"><a href={noticesPage}>{copy.links.notices}</a><a href={noticesUrl} rel="external">{copy.links.repositoryNotices}</a></p>
      </div>
    </section>

    <section class="band" aria-labelledby="build-title">
      <div class="split wrap">
        <div class="split-main">
          <h2 id="build-title">{copy.build.title}</h2>
          <p class="section-lead">{copy.build.body}</p>
          <ol class="steps">
            {copy.build.steps.map((step) => (
              <li><h3>{step.title}</h3><p>{step.body}</p></li>
            ))}
          </ol>
          <p class="link-row"><a class="button button--secondary" href={developers}>{copy.build.cta}</a><a href={developmentGuideUrl} rel="external">{copy.links.guides}</a></p>
        </div>
        <aside class="panel panel--code" aria-labelledby="build-commands">
          <h3 id="build-commands">{copy.build.commands.caption}</h3>
          <pre tabindex="0" role="region" aria-label={copy.build.commands.caption}><code>{copy.build.commands.lines.join('\n')}</code></pre>
        </aside>
      </div>
    </section>

    <section class="band band--subtle" aria-labelledby="contribute-title">
      <div class="wrap">
        <header class="section-head">
          <h2 id="contribute-title">{copy.contribute.title}</h2>
          <p class="section-lead">{copy.contribute.body}</p>
        </header>
        <dl class="ledger">
          {copy.contribute.items.map((item) => (
            <div><dt>{item.term}</dt><dd>{item.body}</dd></div>
          ))}
        </dl>
        <p class="link-row"><a class="button button--secondary" href={contributingUrl} rel="external">{copy.contribute.cta}</a><a href={issuesUrl} rel="external">{copy.links.issues}</a></p>
      </div>
    </section>

    <section class="band" aria-labelledby="status-title">
      <div class="wrap">
        <header class="section-head">
          <h2 id="status-title">{copy.status.title}</h2>
          <p class="section-lead">{copy.status.body}</p>
        </header>
        <ul class="status-list">
          {copy.status.items.map((item) => (
            <li><span class="status-mark" aria-hidden="true"></span><span>{item}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="band band--subtle" aria-labelledby="next-title">
      <div class="wrap">
        <header class="section-head">
          <h2 id="next-title">{copy.next.title}</h2>
          <p class="section-lead">{copy.next.body}</p>
        </header>
        <ul class="link-cards">
          {linkCards.map((card) => (
            <li>
              <a href={card.href} rel={card.external ? 'external' : undefined}>
                <span class="link-card-label">{card.label}</span>
                <span class="icon icon-chevron" aria-hidden="true"></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>
