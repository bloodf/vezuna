{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "node",
        "actions/node-versions"
      ],
      "allowedVersions": "24.22.2"
    },
    {
      "matchPackageNames": [
        "minimatch"
      ],
      "matchCurrentVersion": "^5.0.0",
      "allowedVersions": "<6"
    },
    {
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7"
    }
  ]
}
